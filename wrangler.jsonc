{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceylonroute",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  // nodejs_compat is required so the `resend` and Supabase server SDKs
  // (which use Node built-ins) run on the Workers runtime.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
